{
	"name": "gongo",
	"private": true,
	"description": "Gongo is a 2D side-scrolling platformer where the player goes through levels killing enemies and saving the princess. Each level has amazing hand-picked worlds. On each of the levels, a princess is hidden, which must be rescued and delivered to your castle, cleaning up enemies along the way.",
	"homepage": "https://gongo.tv",
	"bugs": "https://github.com/Gongosoft/Gongovision/issues",
	"license": "ISC",
	"repository": "github.com:Gongosoft/Gongovision",
	"type": "module",
	"scripts": {
		"build": "vue-tsc --build && vite build && bun run build:userscripts",
		"build:only": "vite build",
		"build:site": "vue-tsc --build && vite build",
		"build:userscripts": "vite build --config src/scripts/userscripts/vite.config.ts",
		"deploy": "wrangler deploy",
		"deploy:emotes": "wrangler r2 object put gongo/emotes.zip --file=dist/client/emotes.zip --remote",
		"deploy:preview": "wrangler preview --name",
		"dev": "vite",
		"dev:userscripts": "vite --config src/scripts/userscripts/vite.config.ts",
		"fmt": "oxfmt --disable-nested-config",
		"fmt:check": "oxfmt --disable-nested-config --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "husky && wrangler types src/types/wrangler.d.ts",
		"preview": "vite preview",
		"sync": "bun src/scripts/syncEmotes.ts",
		"typecheck": "vue-tsc --build",
		"typegen": "wrangler types src/types/wrangler.d.ts"
	},
	"dependencies": {
		"@cloudflare/playwright": "^1.3.6",
		"@emulatorjs/emulatorjs": "^4.2.3",
		"@iptv/playlist": "^1.2.1",
		"@iptv/xmltv": "^1.0.1",
		"@tweakpane/plugin-essentials": "^0.2.1",
		"@twurple/auth": "^8.2.0",
		"@twurple/chat": "^8.2.0",
		"@unhead/vue": "^3.4.3",
		"@videojs/hlsjs-video": "10.2.0",
		"@videojs/html": "10.2.0",
		"@vueuse/core": "^15.0.0",
		"@vueuse/router": "^15.0.0",
		"agents": "^0.28.1",
		"animejs": "^4.5.0",
		"aws4fetch": "^1.0.20",
		"blotter.js": "^0.1.0",
		"color": "^5.0.3",
		"cursor-effects": "^1.0.18",
		"fast-xml-parser": "^5.11.2",
		"feed": "^6.0.0",
		"hls.js": "^1.7.3",
		"howler": "^2.2.4",
		"jose": "^6.2.14",
		"konami-code-js": "^0.8.3",
		"mediabunny": "^1.62.0",
		"mime": "^4.1.1",
		"p-limit": "^7.3.3",
		"shadcn": "^4.21.5",
		"shaders": "4.0.4",
		"streamer-emotes": "^0.1.3",
		"tweakpane": "^4.0.5",
		"validator": "^13.15.35",
		"vue": "^3.5.44",
		"vue-3d-model": "^1.4.1",
		"vue-router": "^5.4.0",
		"web-push": "^3.6.7",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@bergbok/prettier-config": "^1.1.0",
		"@cloudflare/vite-plugin": "^1.64.0",
		"@tweakpane/core": "^2.0.5",
		"@types/bun": "^1.4.3",
		"@types/howler": "^2.2.13",
		"@types/konami-code-js": "^0.8.3",
		"@types/validator": "^13.15.10",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/assets-generator": "^2.0.0",
		"@vitejs/plugin-vue": "^6.0.10",
		"@vue/tsconfig": "^0.9.1",
		"discord-api-types": "^0.38.57",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"oxfmt": "^0.70.0",
		"oxlint": "~1.74.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "~6.0.0",
		"unplugin-fonts": "^2.0.0",
		"vite": "^8.3.4",
		"vite-plugin-cloudflare-redirect": "^1.0.3",
		"vite-plugin-fflate-zip": "^0.0.4",
		"vite-plugin-glsl": "^1.6.2",
		"vite-plugin-monkey": "^8.1.1",
		"vite-plugin-pwa": "^2.0.0",
		"vite-plugin-vue-devtools": "^8.1.5",
		"vue-tsc": "^3.3.13",
		"wrangler": "^4.151.0"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,ts,vue}": "oxlint --no-error-on-unmatched-pattern"
	},
	"registries": {
		"@videojs": "https://shadcn.videojs.org/r/html/{name}.json"
	}
}
