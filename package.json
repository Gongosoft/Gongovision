{
	"name": "gongo",
	"private": true,
	"description": "Gongo is a 2D side-scrolling platformer where the player goes through levels killing enemies and saving the princess. Each level has amazing hand-picked worlds. On each of the levels, a princess is hidden, which must be rescued and delivered to your castle, cleaning up enemies along the way.",
	"homepage": "https://gongo.tv",
	"bugs": "https://github.com/Gongosoft/Gongovision/issues",
	"license": "ISC",
	"repository": "github.com:Gongosoft/Gongovision",
	"type": "module",
	"scripts": {
		"build": "vue-tsc --build && vite build",
		"build:only": "vite build",
		"deploy": "wrangler deploy && wrangler r2 object put gongo/emotes.zip --file=dist/client/emotes.zip --remote",
		"deploy:site": "wrangler deploy",
		"dev": "vite",
		"fmt": "oxfmt --disable-nested-config",
		"fmt:check": "oxfmt --disable-nested-config --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"prepare": "husky",
		"preview": "vite preview",
		"sync": "bun src/scripts/syncEmotes.ts",
		"typecheck": "vue-tsc --build",
		"typegen": "wrangler types src/types/wrangler.d.ts"
	},
	"dependencies": {
		"@cloudflare/playwright": "^1.3.3",
		"@emulatorjs/emulatorjs": "^4.2.3",
		"@iptv/xmltv": "^1.0.1",
		"@tweakpane/plugin-essentials": "^0.2.1",
		"@twurple/api": "^8.1.4",
		"@twurple/auth": "^8.1.4",
		"@types/nodemailer": "^8.0.1",
		"@unhead/vue": "^3.2.2",
		"@videojs/html": "^10.0.0-beta.26",
		"@vueuse/core": "^14.3.0",
		"@vueuse/router": "^14.4.0",
		"agents": "^0.20.1",
		"animejs": "^4.5.0",
		"aws4fetch": "^1.0.20",
		"blotter.js": "^0.1.0",
		"color": "^5.0.3",
		"cursor-effects": "^1.0.18",
		"fast-xml-parser": "^5.10.1",
		"howler": "^2.2.4",
		"konami-code-js": "^0.8.3",
		"mime": "^4.1.0",
		"nodemailer": "^9.0.3",
		"p-limit": "^7.3.1",
		"shaders": "2.5.92",
		"streamer-emotes": "^0.1.2",
		"tweakpane": "^4.0.5",
		"validator": "^13.15.35",
		"vue": "^3.5.40",
		"vue-3d-model": "^1.4.1",
		"vue-router": "^5.2.0",
		"web-push": "^3.6.7"
	},
	"devDependencies": {
		"@bergbok/prettier-config": "^1.1.0",
		"@cloudflare/vite-plugin": "^1.49.0",
		"@tweakpane/core": "^2.0.5",
		"@types/bun": "^1.3.14",
		"@types/howler": "^2.2.13",
		"@types/konami-code-js": "^0.8.3",
		"@types/validator": "^13.15.10",
		"@types/video.js": "^7.3.58",
		"@types/web-push": "^3.6.4",
		"@vite-pwa/assets-generator": "^1.0.2",
		"@vitejs/plugin-vue": "^6.0.8",
		"@vue/tsconfig": "^0.9.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.1.1",
		"oxfmt": "^0.59.0",
		"oxlint": "~1.74.0",
		"oxlint-tsgolint": "^7.0.2001",
		"typescript": "~7.0.2",
		"unplugin-fonts": "^2.0.0",
		"vite": "^8.1.5",
		"vite-plugin-cloudflare-redirect": "^1.0.3",
		"vite-plugin-fflate-zip": "^0.0.4",
		"vite-plugin-pwa": "^1.3.0",
		"vite-plugin-vue-devtools": "^8.1.5",
		"vue-tsc": "^3.3.7",
		"wrangler": "^4.116.0"
	},
	"lint-staged": {
		"*": "oxfmt --no-error-on-unmatched-pattern",
		"*.{js,ts,vue}": "oxlint --no-error-on-unmatched-pattern"
	}
}
